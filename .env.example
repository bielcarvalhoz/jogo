# Frontend (Vite / Vercel): use the actual HTTPS URL Render gives your service.
# Local development automatically uses http://localhost:3001.
# VITE_SERVER_URL=https://seu-jogo-server.onrender.com

# Optional WebRTC ICE list. Default: public STUN; Socket.IO always works as fallback.
# VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Server (Render): exact additional browser origins, comma-separated.
# localhost and *.vercel.app are allowed by default, as in Defend the Crystal.
# CLIENT_ORIGINS=https://seu-dominio.com.br
# PORT=3001
